`src/app/customers/services.py`:
```python
from types import TracebackType
from typing import Protocol, Self
from uuid import uuid7

from pydantic import BaseModel, ConfigDict, EmailStr, Field

from app.customers.domain import Customer, CustomerId, CustomerRestrictedError


class CustomerRepository(Protocol):
    """Persistence contract for customers."""

    async def get_by_id(self, customer_id: CustomerId) -> Customer | None: ...
    async def add(self, customer: Customer) -> None: ...


class UnitOfWork(Protocol):
    """Transaction boundary; changes persist only on `commit()`."""

    @property
    def customers(self) -> CustomerRepository: ...

    async def __aenter__(self) -> Self: ...
    async def __aexit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: TracebackType | None,
    ) -> None: ...
    async def commit(self) -> None: ...


class RegisterCustomerCommand(BaseModel):
    """Input for registering a customer."""

    model_config = ConfigDict(frozen=True, strict=True, extra="forbid")

    email: EmailStr = Field(max_length=255)
    age: int = Field(ge=18)


class CustomerService:
    """Application service for customer registration."""

    __slots__ = ("_uow",)

    def __init__(self, uow: UnitOfWork) -> None:
        self._uow = uow

    async def register(self, command: RegisterCustomerCommand) -> CustomerId:
        """Register a customer in a single transaction.

        Args:
            command: A validated registration command.

        Returns:
            The ID of the newly registered customer.

        Raises:
            CustomerRestrictedError: If the customer violates an eligibility rule.
        """
        customer = self._to_domain(command)

        async with self._uow:
            await self._uow.customers.add(customer)
            await self._uow.commit()

        return customer.id

    @staticmethod
    def _to_domain(command: RegisterCustomerCommand) -> Customer:
        is_restricted_domain = command.email.endswith("@baddomain.com")

        if is_restricted_domain and command.age < 21:
            raise CustomerRestrictedError("Restricted domain requires age 21+")

        return Customer(id=uuid7(), email=command.email, age=command.age)
```

`tests/customers/test_services.py`:
```python
from types import TracebackType
from typing import Self, override

from app.customers.domain import Customer, CustomerId
from app.customers.services import (
    CustomerRepository,
    CustomerService,
    RegisterCustomerCommand,
    UnitOfWork,
)


class InMemoryCustomerRepository(CustomerRepository):
    def __init__(self) -> None:
        self._items: dict[CustomerId, Customer] = {}

    @override
    async def get_by_id(self, customer_id: CustomerId) -> Customer | None:
        return self._items.get(customer_id)

    @override
    async def add(self, customer: Customer) -> None:
        self._items[customer.id] = customer


class InMemoryUnitOfWork(UnitOfWork):
    def __init__(self) -> None:
        self._customers = InMemoryCustomerRepository()
        self.is_committed = False

    @property
    @override
    def customers(self) -> CustomerRepository:
        return self._customers

    @override
    async def __aenter__(self) -> Self:
        return self

    @override
    async def __aexit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: TracebackType | None,
    ) -> None:
        return None

    @override
    async def commit(self) -> None:
        self.is_committed = True


async def test_register_persists_and_commits_customer() -> None:
    # Arrange
    uow = InMemoryUnitOfWork()
    service = CustomerService(uow)
    command = RegisterCustomerCommand(email="ada@example.com", age=30)

    # Act
    customer_id = await service.register(command)

    # Assert
    assert uow.is_committed
    assert await uow.customers.get_by_id(customer_id) is not None
```
